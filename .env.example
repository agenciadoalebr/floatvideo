# Supabase — projeto "video-flutuante" (sa-east-1)
#
# Estas duas sao publicas por design: a anon key ja viaja dentro do
# player.js servido a qualquer visitante do site do cliente. Toda a
# protecao real esta nas policies de RLS e nas RPCs SECURITY DEFINER.
NEXT_PUBLIC_SUPABASE_URL=https://shlblslzuyubhutzypid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNobGJsc2x6dXl1Ymh1dHp5cGlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczMjI0MDEsImV4cCI6MjEwMjg5ODQwMX0.4x1jByYqrXG-KXkQo3SvAhIzgYpvTOPuS_KNHDz2-wk

# NUNCA exponha a service_role key no client. So o servidor usa, na rota
# administrativa de exclusao de usuario (app/api/admin/delete-user).
# Pegue em Supabase > Project Settings > API > service_role.
# Em producao ela vive nas variaveis de ambiente da Vercel, nao aqui.
SUPABASE_SERVICE_ROLE_KEY=

# Usado so no ambiente local, pro link de redefinicao de senha apontar
# pra maquina certa. Em producao o app usa window.location.origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Armazenamento de video: nao ha variavel aqui de proposito.
#
# Os uploads vao pro bucket publico "videos" do proprio Supabase Storage
# (limite de 500MB por arquivo; MP4/WebM/MOV). A URL publica e gerada em
# tempo de upload e gravada em videos.mp4_url, entao o widget nao precisa
# de credencial nenhuma pra tocar o video.
#
# Uma versao anterior deste arquivo previa Cloudflare R2 e uma fila
# Redis/BullMQ para processamento. Nada disso chegou a ser implementado —
# as variaveis foram removidas para o arquivo parar de descrever uma
# arquitetura que nao existe. A compressao acontece no navegador de quem
# sobe (ffmpeg.wasm), antes do upload, entao nao ha worker nem fila.
#
# Quando reconsiderar: o plano Free do Supabase da 1GB de storage e 5GB
# de banda/mes. Se o uso se aproximar disso, ai sim vale comparar com R2
# (que nao cobra egress). Ver db/README.md.
# ---------------------------------------------------------------------
